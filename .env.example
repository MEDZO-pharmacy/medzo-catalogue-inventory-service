Database__Provider=SqlServer
ConnectionStrings__CatalogueInventory=Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=medzo_inventory_db;User ID=YOUR_USER;Password=CHANGE_ME;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Jwt__Secret=CHANGE_ME_USE_THE_AUTH_SERVICE_SIGNING_SECRET
Jwt__Issuer=MedzoAuthService
Jwt__Audience=MedzoClient

Jwt__ExpirationInMinutes=60
Jwt__RefreshTokenExpirationInDays=7

# Add one indexed entry per browser origin that may call the API.
Cors__AllowedOrigins__0=http://localhost:5173

# Development only. Set true locally to insert idempotent demonstration records.
SeedDemoData__Enabled=false

# Keep false while checking Catalogue/Inventory CRUD without a local Kafka broker.
# Set true when testing purchase and sale event integration.
Kafka__Enabled=false
Kafka__BootstrapServers=localhost:9092
