{
  "stryker-config": {
    "project": "Medzo.CatalogueInventory.Domain.csproj",
    "mutate": [
      "**/Catalogue/Medicine.cs",
      "**/Inventory/InventoryItem.cs",
      "**/Inventory/StockBatch.cs"
    ],
    "mutation-level": "Standard",
    "test-runner": "mtp",
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "concurrency": 2,
    "configuration": "Release"
  }
}
